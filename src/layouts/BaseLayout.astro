---
import "../styles/fonts.css";
import "../styles/global.css";

import BaseHead, { type AlternateLink, type ArticleMeta } from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SearchModal from "../components/SearchModal.astro";
import { SITE } from "../config";
import { getDict } from "../i18n/dict";
import { DEFAULT_LOCALE, LOCALES, htmlLang, localizedPath, ogLocale, unlocalizedPath, type LocaleRoute } from "../i18n/locales";
import { localesWithPublications } from "../i18n/posts";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: ArticleMeta;
  author?: string;
  canonicalUrl?: string;
  overlayHeader?: boolean;
  locale?: string;
  alternateRoutes?: LocaleRoute[];
  feed?: string | false;
  xDefault?: string | false;
  feedTitle?: string;
  pagefindIgnore?: boolean;
}

const {
  title,
  description,
  ogImage,
  article,
  author,
  canonicalUrl,
  overlayHeader = false,
  locale = DEFAULT_LOCALE,
  alternateRoutes = (LOCALES as readonly { route: LocaleRoute }[]).map(({ route }) => route),
  feed,
  xDefault: xDefaultProp,
  feedTitle,
  pagefindIgnore = false,
} = Astro.props;

const dict = getDict(locale);
const lang = htmlLang(locale);

const unprefixed = unlocalizedPath(Astro.url.pathname);

const alternates: AlternateLink[] = alternateRoutes.map((route) => ({
  lang: htmlLang(route),
  href: localizedPath(unprefixed === "" ? "/" : unprefixed, route),
}));
const xDefault =
  xDefaultProp !== undefined
    ? xDefaultProp || undefined
    : localizedPath(unprefixed === "" ? "/" : unprefixed, DEFAULT_LOCALE);
const ogAlternates = alternateRoutes.filter((route) => route !== locale).map((route) => ogLocale(route));

const feedLocales = await localesWithPublications();
const feedPath =
  feed !== undefined
    ? feed || undefined
    : feedLocales.includes(locale as LocaleRoute)
      ? localizedPath("/rss.xml", locale)
      : undefined;

const pageTitle = title
  ? `${title} — ${SITE.title}`
  : `${SITE.title} — ${dict.siteTagline}`;
const pageDescription = description ?? dict.siteDescription;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={pageTitle}
      description={pageDescription}
      ogImage={ogImage}
      article={article}
      author={author}
      canonicalUrl={canonicalUrl}
      lang={lang}
      ogLocale={ogLocale(locale)}
      ogAlternates={ogAlternates}
      alternates={alternates}
      xDefault={xDefault}
      feedPath={feedPath}
      feedTitle={feedTitle ?? `${SITE.title} — ${dict.siteTagline}`}
      breadcrumbHome={dict.notFoundHome}
    />
    <slot name="head" />
  </head>

  <body data-pagefind-ignore={pagefindIgnore ? "" : undefined}>
    <a class="skip-link" href="#main">{dict.skip}</a>
    <Header overlay={overlayHeader} locale={locale} alternateRoutes={alternateRoutes} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} feedPath={feedPath || false} />
    <SearchModal locale={locale} />
  </body>
</html>
