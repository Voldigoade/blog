---
import { BLOG } from "../config";
import { formatDateStamp, isoDate } from "../utils/date";
import { readingTime } from "../utils/reading-time";
import { readingText, sectionText } from "../i18n/dict";
import { DEFAULT_LOCALE, localizedPath, publicationPath } from "../i18n/locales";
import type { TranslatedPost } from "../i18n/posts";
import type { Post } from "../utils/posts";

interface Props {
  post: Post | TranslatedPost;
  locale?: string;
  slug?: string;
}

const { post, locale = DEFAULT_LOCALE, slug } = Astro.props;
const { title, description, pubDate, draft, section } = post.data;
const minutes = readingTime(post.body);
const sectionLabel = section ? sectionText(locale, section).name : section;
const href = publicationPath(slug ?? post.id, locale);
---

<article class="post-card" data-section={section}>
  <p class="post-card__stamp label">
    <time datetime={isoDate(pubDate)}>{formatDateStamp(pubDate)}</time>
    {draft && <span class="post-card__draft">Brouillon</span>}
  </p>

  <div class="post-card__body">
    <h3 class="post-card__title">
      <a href={href}>{title}</a>
    </h3>

    <p class="post-card__description">{description}</p>

    <p class="post-card__meta label">
      {
        section && (
          <a class="post-card__section" href={localizedPath(`/sections/${section}/`, locale)}>
            {sectionLabel}
          </a>
        )
      }
      {
        BLOG.showReadingTime && (
          <span class="post-card__time">{readingText(locale, minutes)}</span>
        )
      }
    </p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-6);
    padding: var(--space-8) 0;
    border-bottom: var(--rule-width) solid var(--color-rule);
    transition: background var(--duration-fast) var(--ease-out);
  }

  .post-card:hover {
    background: var(--color-bg-subtle);
  }

  .post-card__stamp {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: 0.35rem;
  }

  .post-card__draft {
    color: var(--color-accent);
  }

  .post-card__title {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .post-card__title a {
    text-decoration: none;
  }

  .post-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post-card__description {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
  }

  .post-card__meta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4);
    margin-top: var(--space-4);
    text-transform: none;
  }

  .post-card__time {
    margin-left: auto;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  @media (max-width: 40rem) {
    .post-card {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding-block: var(--space-6);
    }

    .post-card__stamp {
      flex-direction: row;
      gap: var(--space-4);
      padding-top: 0;
    }

    .post-card__time {
      margin-left: 0;
    }
  }
</style>
