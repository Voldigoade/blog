{
  "name": "voldigoade-blog",
  "type": "module",
  "version": "1.1.0",
  "description": "Voldigoade personal publication in ink and washi paper. Astro 7 static site, French canonical with English, Spanish, German, Brazilian Portuguese, Italian, Japanese and Simplified Chinese interfaces.",
  "license": "MIT",
  "author": "Voldigoade",
  "homepage": "https://voldigoade.github.io/blog/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Voldigoade/blog.git"
  },
  "bugs": {
    "url": "https://github.com/Voldigoade/blog/issues"
  },
  "keywords": [
    "astro",
    "astro-blog",
    "blog",
    "minimal",
    "dark-mode",
    "mdx",
    "typography",
    "webgl",
    "multilingual",
    "i18n"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "verify": "node scripts/verify-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "translate": "node scripts/translate.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.1.6",
    "js-yaml": "4.3.2",
    "katex": "0.18.7",
    "pagefind": "1.5.2",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "satori": "^0.29.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
